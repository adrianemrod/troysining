DATABASE_URL="postgresql://postgres:postgres@localhost:5432/troysining?schema=public"
JWT_SECRET="change-this-to-a-long-random-string"
NEXT_PUBLIC_APP_NAME="Troysining Printing Management System"
# Public URL of this deployment, used to build invite/reset links that get
# copied or emailed outside the current request. Required in production —
# behind a reverse proxy (Railway, etc.) the request's own origin can resolve
# to an internal address instead of your real domain. Leave unset for local
# dev; it'll fall back to http://localhost:3000.
APP_URL="https://your-app.up.railway.app"
