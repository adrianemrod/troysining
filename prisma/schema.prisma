generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  SALES
  PRODUCTION
  DELIVERY
  ENCODER
}

enum ClientType {
  ONE_TIME
  REPEAT
}

enum VatType {
  VAT
  NON_VAT
}

enum LeadStage {
  NEW_INQUIRY
  QUOTED
  CONFIRMED
  IN_PRODUCTION
  DELIVERED
  CLOSED
}

enum ProductionStage {
  PENDING
  DESIGNING
  PRINTING
  FINISHING
  QUALITY_CHECK
  READY_FOR_DELIVERY
  COMPLETED
}

enum DeliveryMethod {
  PICKUP
  IN_HOUSE
  COURIER
}

enum DeliveryStatus {
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_RESCHEDULED
}

enum FileCategory {
  DESIGN
  PROOF
  FINAL
  CONTRACT
  QUOTATION
  FB_SCREENSHOT
  OTHER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// ---------------------------------------------------------------------------
// Users & Auth
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  avatarColor  String   @default("#1f3f5b")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  clientsOwned        Client[]              @relation("ClientSalesOwner")
  clientNotes         ClientNote[]
  orders               Order[]              @relation("OrderSalesperson")
  productionJobs       ProductionJob[]      @relation("ProductionAssignee")
  productionStatusLogs ProductionStatusLog[]
  deliveries           Delivery[]           @relation("DeliveryRider")
  filesUploaded        File[]
  activityLogs         ActivityLog[]
  invitesSent          Invite[]             @relation("InviteSender")
  passwordResets        PasswordResetToken[]
  expensesRecorded      Expense[]

  @@index([role])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model Invite {
  id          String       @id @default(cuid())
  email       String
  role        Role
  token       String       @unique
  status      InviteStatus @default(PENDING)
  invitedById String
  invitedBy   User         @relation("InviteSender", fields: [invitedById], references: [id])
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime     @default(now())
}

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------

model Client {
  id           String     @id @default(cuid())
  name         String
  businessName String?
  contactNumber String?
  fbHandle     String?
  email        String?
  address      String?
  clientType   ClientType @default(ONE_TIME)
  leadStage    LeadStage  @default(NEW_INQUIRY)
  salesOwnerId String?
  salesOwner   User?      @relation("ClientSalesOwner", fields: [salesOwnerId], references: [id])
  driveFolderId String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  notes  ClientNote[]
  orders Order[]
  files  File[]

  @@index([leadStage])
  @@index([salesOwnerId])
}

model ClientNote {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId       String
  author         User     @relation(fields: [authorId], references: [id])
  content        String
  attachmentUrl  String?
  createdAt      DateTime @default(now())

  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Products
// ---------------------------------------------------------------------------

model Product {
  id             String   @id @default(cuid())
  name           String
  category       String
  description    String?
  unit           String   @default("piece")
  unitPrice      Decimal  @db.Decimal(10, 2)
  turnaroundDays Int      @default(3)
  specs          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orderItems OrderItem[]

  @@index([category])
}

// ---------------------------------------------------------------------------
// Sales / Orders
// ---------------------------------------------------------------------------

model Order {
  id             String    @id @default(cuid())
  orderNumber    String    @unique
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id])
  salespersonId  String
  salesperson    User      @relation("OrderSalesperson", fields: [salespersonId], references: [id])
  status         LeadStage @default(QUOTED)
  dueDate        DateTime
  vatType        VatType   @default(NON_VAT)
  vatAmount      Decimal   @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal   @db.Decimal(10, 2)
  downpayment    Decimal   @default(0) @db.Decimal(10, 2)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items          OrderItem[]
  productionJob  ProductionJob?
  delivery       Delivery?
  files          File[]

  @@index([dueDate])
  @@index([status])
  @@index([clientId])
  @@index([salespersonId])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  customName String?
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  specs      String?
  subtotal   Decimal  @db.Decimal(10, 2)

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Production
// ---------------------------------------------------------------------------

model ProductionJob {
  id               String          @id @default(cuid())
  orderId          String          @unique
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stage            ProductionStage @default(PENDING)
  assignedStaffId  String?
  assignedStaff    User?           @relation("ProductionAssignee", fields: [assignedStaffId], references: [id])
  isAtRisk         Boolean         @default(false)
  startedAt        DateTime?
  updatedAt        DateTime        @updatedAt
  createdAt        DateTime        @default(now())

  statusLogs ProductionStatusLog[]

  @@index([stage])
  @@index([assignedStaffId])
}

model ProductionStatusLog {
  id              String        @id @default(cuid())
  productionJobId String
  productionJob   ProductionJob @relation(fields: [productionJobId], references: [id], onDelete: Cascade)
  stage           ProductionStage
  note            String?
  photoUrl        String?
  authorId        String
  author          User          @relation(fields: [authorId], references: [id])
  createdAt       DateTime      @default(now())

  @@index([productionJobId])
}

// ---------------------------------------------------------------------------
// Delivery
// ---------------------------------------------------------------------------

model Delivery {
  id           String         @id @default(cuid())
  orderId      String         @unique
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method       DeliveryMethod @default(PICKUP)
  status       DeliveryStatus @default(PREPARING)
  riderId      String?
  rider        User?          @relation("DeliveryRider", fields: [riderId], references: [id])
  deliveryDate DateTime?
  address      String?
  proofUrl     String?
  signatureUrl String?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status])
  @@index([riderId])
}

// ---------------------------------------------------------------------------
// Files
// ---------------------------------------------------------------------------

model File {
  id           String       @id @default(cuid())
  clientId     String
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  orderId      String?
  order        Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  uploadedById String
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])
  filename     String
  url          String
  mimeType     String?
  sizeBytes    Int?
  category     FileCategory @default(OTHER)
  version      Int          @default(1)
  parentFileId String?
  createdAt    DateTime     @default(now())

  @@index([clientId])
  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Activity Log
// ---------------------------------------------------------------------------

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Expenses
// ---------------------------------------------------------------------------

model Expense {
  id            String   @id @default(cuid())
  date          DateTime
  category      String
  description   String
  amount        Decimal  @db.Decimal(10, 2)
  vendor        String?
  paymentMethod String?
  notes         String?
  recordedById  String
  recordedBy    User     @relation(fields: [recordedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([date])
  @@index([category])
}
